---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AddToCartButton from '../../components/AddToCartButton';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await product.render();
---

<Layout title={data.title} description={data.description}>
  <div class="w-full px-4 sm:px-8 lg:px-12 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 font-medium">
      <a href="/" class="hover:text-emerald-600 transition-colors">Trang chủ</a>
      <span>/</span>
      <span class="text-slate-400">{data.category}</span>
      <span>/</span>
      <span class="text-slate-800 font-semibold truncate max-w-xs">{data.title}</span>
    </nav>

    <!-- Product Layout -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-lg grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
      <!-- Cột Trái: Ảnh Sản Phẩm -->
      <div class="space-y-4">
        <div class="aspect-square rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 relative">
          <img
            src={data.image}
            alt={data.title}
            class="w-full h-full object-cover"
          />
          {data.badge && (
            <span class="absolute top-4 left-4 bg-slate-900/90 text-emerald-400 text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider border border-emerald-500/30">
              {data.badge}
            </span>
          )}
        </div>
      </div>

      <!-- Cột Phải: Thông Tin & Tương Tác -->
      <div class="space-y-6">
        <div>
          <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider font-mono">
            {data.category}
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1 leading-snug">
            {data.title}
          </h1>

          <div class="flex items-center gap-2 mt-3 text-xs">
            <div class="flex text-amber-500">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <span class="font-bold text-slate-700">{data.rating}</span>
            <span class="text-slate-400">({data.reviewsCount} đánh giá từ khách hàng)</span>
          </div>
        </div>

        <!-- Giá sản phẩm -->
        <div class="bg-slate-50 p-4 rounded-2xl border border-slate-100 flex items-baseline gap-3">
          <span class="text-3xl sm:text-4xl font-extrabold text-slate-900">${data.price}</span>
          {data.originalPrice && (
            <span class="text-base text-slate-400 line-through">${data.originalPrice}</span>
          )}
          <span class="text-xs bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded font-mono">
            {data.inStock ? 'Còn hàng trong kho' : 'Hết hàng'}
          </span>
        </div>

        <p class="text-sm text-slate-600 leading-relaxed">
          {data.description}
        </p>

        <!-- Thông số kỹ thuật (Specs) -->
        {data.specs && data.specs.length > 0 && (
          <div class="border-t border-slate-100 pt-4">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2">Thông Số Nổi Bật</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-600">
              {data.specs.map((spec) => (
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  <span>{spec}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Client Island: Nút thêm giỏ hàng cỡ lớn -->
        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center gap-4">
          <AddToCartButton
            client:load
            variant="large"
            product={{
              id: data.id,
              title: data.title,
              price: data.price,
              image: data.image,
            }}
          />
          <a
            href="/"
            class="text-xs text-slate-500 hover:text-emerald-600 font-medium transition-colors"
          >
            ← Quay lại danh mục
          </a>
        </div>

        <!-- Render nội dung chi tiết từ Markdown Body -->
        <div class="border-t border-slate-100 pt-6 prose prose-sm prose-slate max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </div>
</Layout>
