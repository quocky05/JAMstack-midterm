---
import type { CollectionEntry } from 'astro:content';
import AddToCartButton from './AddToCartButton';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { slug, data } = product;
---

<div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col group relative">
  <!-- Badge kiến trúc & khuyến mãi -->
  <div class="absolute top-3 left-3 z-10 flex flex-col gap-1 items-start">
    {data.badge && (
      <span class="bg-slate-900/90 backdrop-blur-md text-emerald-400 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider border border-emerald-500/30">
        {data.badge}
      </span>
    )}
  </div>

  <!-- Hình ảnh sản phẩm -->
  <a href={`/product/${slug}`} class="block aspect-square overflow-hidden bg-slate-100 relative">
    <img
      src={data.image}
      alt={data.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
  </a>

  <!-- Nội dung thông tin -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
        <span class="font-medium text-emerald-600 uppercase tracking-wider">{data.category}</span>
        <span>•</span>
        <div class="flex items-center gap-1 text-amber-500">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span class="font-bold text-slate-700">{data.rating}</span>
          <span class="text-slate-400">({data.reviewsCount})</span>
        </div>
      </div>

      <a href={`/product/${slug}`} class="block">
        <h3 class="text-base font-bold text-slate-900 group-hover:text-emerald-600 transition-colors line-clamp-2">
          {data.title}
        </h3>
      </a>
      
      <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
        {data.description}
      </p>
    </div>

    <!-- Giá và Nút tương tác Island -->
    <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between">
      <div>
        <div class="flex items-baseline gap-2">
          <span class="text-xl font-extrabold text-slate-900">${data.price}</span>
          {data.originalPrice && (
            <span class="text-xs text-slate-400 line-through">${data.originalPrice}</span>
          )}
        </div>
      </div>

      <!-- Island Button: Chỉ nút này được load JavaScript tương tác -->
      <AddToCartButton
        client:visible
        product={{
          id: data.id,
          title: data.title,
          price: data.price,
          image: data.image,
        }}
      />
    </div>
  </div>
</div>
